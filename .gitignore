# build outputs
build/
*.o
*.out
*.dSYM/
# results are committed, but not the big raw logs over 1 MB or scratch runs
results/scratch-*/
results/**/*.core
# editors
.DS_Store
.vscode/
__pycache__/
# third-party sources fetched by tools/fetch-sqlite.sh (pinned by hash, never committed)
vendor/
# report/build holds the LaTeX outputs (make -C report); only the folder itself is tracked
!report/build/
report/build/*
!report/build/.gitkeep
