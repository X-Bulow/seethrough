{
  "case": 14,
  "class": "invalid-free",
  "access": "free",
  "title": "free a pointer 8 bytes into an object instead of the one st_alloc returned",
  "object": "a, 24 bytes; st_free(a + 8)",
  "control": "frees a; one alloc and one free in both images",
  "expected": {
    "asan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "The one class where the malloc baseline is enforced by the ALLOCATOR and not only by the tool: the chunk header is not where libc expects. The arena looks a+8 up in its side table, finds no object and leaves it alone. The free list pushes a+8 onto a size-class list and misaligns every later object in that class, so the damage appears far from here -- which is why the case records what it did instead of waiting for a crash. Its annotated arm unpoisons the link word before writing it, so ASan sees no bad access: MISSED, for the same reason as case 13 (measured 2026-11-07; the earlier DETECTED was a guess marked to verify)."
    },
    "valgrind": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "MEMPOOL_FREE of an address that is not a pool allocation is reported as an invalid free; both annotated pools pass a+8 to it (including the arena)."
    },
    "hwasan": {
      "malloc": "MISSED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "MISSED on malloc too: HWASan's free accepted a + 8 without a report (clang 21.1.8 runtime, 2026-11-11), where glibc and ASan reject it. The pool columns are MISSED as in case 13."
    },
    "ubsan": {
      "malloc": "MISSED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "-fsanitize=bounds needs a statically known array bound; a pointer out of an allocator has none. The row is kept so the report can say UBSan is not a heap tool rather than leaving it out."
    },
    "lowfat": {
      "malloc": "DETECTED (to verify)",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "LowFat can check that a freed pointer is its region's base, which is a bounds question; to verify."
    }
  },
