{
  "case": 8,
  "class": "use-after-free",
  "access": "write",
  "title": "write through a stale pointer, with no allocation between the free and the use",
  "object": "a, 24 bytes, freed and then written",
  "control": "the same single alloc and single free, with the write before the free instead of after it",
  "expected": {
    "asan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "THE ANNOTATION-FEASIBILITY ROW. ASan's quarantine and shadow catch it on malloc. To win it back an annotated allocator must re-poison the object at free time, which needs the object's size. A pure bump arena does not keep it, so before B1.2 the annotated arena stayed blind (the 2026-11-05 smoke); B1.2 added a side table of sizes and liveness outside the pool, and the annotated arena now catches it. The price of annotation is per-object bookkeeping the allocator did not otherwise need, not only the macros. The free list knows its size class, so its annotated arm works the same way. Both unannotated pools stay blind: the storage is still inside one live malloc block."
    },
    "valgrind": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "Same split, via VALGRIND_MEMPOOL_FREE, which both annotated pools call in st_free and which makes the block NOACCESS. Before B1.2 the arena never called it."
    },
    "hwasan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "malloc retags on free, so the stale pointer's tag no longer matches. Unannotated, the freed object still carries the pool's tag, which the stale pointer carries too. Annotated, st_free hands the object's granules back to the pool's tag while the stale pointer keeps the object's own."
    },
    "ubsan": {
      "malloc": "MISSED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "-fsanitize=bounds needs a statically known array bound; a pointer out of an allocator has none. The row is kept so the report can say UBSan is not a heap tool rather than leaving it out."
    },
    "lowfat": {
      "malloc": "UNSUPPORTED",
      "arena": "UNSUPPORTED",
      "arena+annot": "UNSUPPORTED",
      "freelist": "UNSUPPORTED",
      "freelist+annot": "UNSUPPORTED",
      "why": "LowFat checks bounds only; it has no notion of a lifetime."
    }
  },
