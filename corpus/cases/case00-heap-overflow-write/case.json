{
  "case": 0,
  "class": "heap-overflow",
  "access": "write",
  "title": "1-byte write past the end of a 24-byte object into its neighbour",
  "object": "a, 24 bytes, the first of two consecutive st_alloc(24)",
  "offset_bytes": 24,
  "neighbour": "b, allocated immediately after a",
  "control": "writes a[23] instead of a[24]; allocation traffic identical",
  "expected": {
    "asan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "ASan keeps the request size, so offset 24 is in the right redzone on malloc and in the arena's 16-byte alignment slack (24..31) when the allocator unpoisons exactly n. Note what saves this row: the slack. An overflow that reached b[0] at offset 32 would be a live byte and MISSED even annotated -- case 3."
    },
    "valgrind": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "Memcheck tracks addressability per block; VALGRIND_MEMPOOL_ALLOC is given n, not the rounded size, so the slack stays NOACCESS."
    },
    "hwasan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "malloc: a 24-byte block ends mid-granule and HWASan's short-granule encoding keeps the size in the granule's last byte, so offset 24 is caught. In a pool every object carries the pool's tag, the one HWASan's malloc gave the backing block, so the unannotated columns are MISSED. The annotated columns tag whole 16-byte granules -- the public interface has no short-granule form -- and offset 24 lies in a's own second granule, so they stay MISSED: the one row where annotated HWASan is weaker than annotated ASan, which unpoisons exactly n bytes."
    },
    "ubsan": {
      "malloc": "MISSED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "-fsanitize=bounds needs a statically known array bound; a pointer out of an allocator has none. The row is kept so the report can say UBSan is not a heap tool rather than leaving it out."
    },
    "lowfat": {
      "malloc": "MISSED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "LowFat's bounds are the SIZE CLASS, 32 bytes for a 24-byte request, so offset 24 is in bounds even on malloc. Documented sub-object imprecision, not an allocator effect: compare case 3, where the offset leaves the class."
    }
  },
