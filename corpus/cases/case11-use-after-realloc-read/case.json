{
  "case": 11,
  "class": "use-after-free",
  "access": "read",
  "title": "read through a pointer st_realloc invalidated by moving the object",
  "object": "a, 24 bytes, grown to 4096 by st_realloc, which frees the old block when it moves",
  "control": "reads through the pointer st_realloc returned",
  "requires": {
    "marker": "moved=1",
    "why": "st_realloc must have succeeded AND moved the object. An allocator that returns NULL or grows in place has no stale pointer and no defect. The arena and the free list always move."
  },
  "note": "The shape of SQLite's agginfo defect (capstone case 01) and of PostgreSQL's repalloc rows: no free() appears in the source, which is why it survives code review.",
  "expected": {
    "asan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "On malloc realloc's old block goes to the quarantine. Both pool allocators implement st_realloc as allocate, copy, st_free, so the old block is re-poisoned exactly when the annotated arm is on; unannotated, the old bytes stay readable inside the live pool."
    },
    "valgrind": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "As above, with MEMPOOL_FREE on the old block."
    },
    "hwasan": {
      "malloc": "DETECTED",
      "arena": "MISSED",
      "arena+annot": "DETECTED",
      "freelist": "MISSED",
      "freelist+annot": "DETECTED",
      "why": "malloc retags the old block. In a pool the stale pointer keeps the pool's tag unless st_free retags the old object, which the annotated arms do."
    },
    "ubsan": {
      "malloc": "MISSED",
      "arena": "MISSED",
      "arena+annot": "MISSED",
      "freelist": "MISSED",
      "freelist+annot": "MISSED",
      "why": "-fsanitize=bounds needs a statically known array bound; a pointer out of an allocator has none. The row is kept so the report can say UBSan is not a heap tool rather than leaving it out."
    },
    "lowfat": {
      "malloc": "UNSUPPORTED",
      "arena": "UNSUPPORTED",
      "arena+annot": "UNSUPPORTED",
      "freelist": "UNSUPPORTED",
      "freelist+annot": "UNSUPPORTED",
      "why": "LowFat checks bounds only; it has no notion of a lifetime."
    }
  },
